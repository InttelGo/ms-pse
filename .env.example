APP_ENV=development
APP_SEED=true
TIMEZONE=America/Bogota
PORT=8009
LOG_LEVEL=INFO

# Otros microservicios
MS_BUILD_URL=http://localhost:8008
MS_SERVICE_URL=http://localhost:8007

# URL del landing donde se paga un enlace generado (se le agrega /pse?payment=<hash>)
LANDINGPAGE_URL=
# Secreto para cifrar ticket e id de URL en los enlaces (AES-256-CBC, igual que TOKEN_SECRET del backend Node)
PSE_HASH_SECRET=

# PSE (ACH Colombia)
PSE_URL=
PSE_AUTH_PATH=
PSE_VERSION=v2
PSE_API_KEY=
PSE_CLIENT_ID=
PSE_CLIENT_SECRET=
PSE_ENCRYPT_KEY=
PSE_ENCRYPT_IV=
PSE_ENTITY_CODE=
PSE_SERVICE_CODE=
# URL de retorno; se le concatena el ticket cifrado
PSE_ENTITY_URL=
PSE_BENEFICIARY_TYPE=
PSE_BENEFICIARY_IDENTIFY=
PSE_BENEFICIARY_NAME=
PSE_BENEFICIARY_CATEGORY=
PSE_TIMEOUT_SECONDS=30
# Máximo de caracteres de paymentDescription que acepta PSE
PSE_DESCRIPTION_MAX_LENGTH=80

# Verificación de transacciones pendientes
PSE_PENDING_JOB=true
PSE_PENDING_CRON=0 */3 * * * *
PSE_PENDING_MAX_HOURS=24

# Factura y pagos en ms-build cuando una transacción se aprueba
# Usuario "Mi Recaudo PSE": create_by de la transacción y X-User-Id hacia ms-build
PSE_SYSTEM_USER_ID=119
PSE_BUILD_METHOD_ID=2
PSE_BUILD_OFFICE_ID=1
PSE_BUILD_STATUS_ID=1
PSE_ELECTRONIC_BUILD=false

# reCAPTCHA
RECAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ms-pse
